# 平台环境变量模板 —— 复制为同目录 .env 并按需修改（.env 不入库）
#   cp deploy/env/.env.example deploy/env/.env

# PostgreSQL
POSTGRES_USER=brp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=broker_resilience

# Redis
REDIS_PASSWORD=change-me

# BRP 后端（go 容器）——密钥生成方式见 backend/configs/config.example.yaml 注释
BRP_AUTH_JWT_SECRET=CHANGE_ME
BRP_INSTANCE_ENCRYPT_KEY=CHANGE_ME
