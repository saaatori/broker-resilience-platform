# 平台环境变量模板 —— 复制为同目录 .env 并按需修改（.env 不入库）
#   cp deploy/env/.env.example deploy/env/.env

# PostgreSQL
POSTGRES_USER=brp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=broker_resilience

# Redis
REDIS_PASSWORD=change-me

# BRP 后端（go 容器）——密钥生成方式见 backend/configs/config.example.yaml 注释
BRP_AUTH_JWT_SECRET=CHANGE_ME
BRP_INSTANCE_ENCRYPT_KEY=CHANGE_ME
# 种子管理员口令（**仅库中无用户时**写入一次；对存量库不生效——已有用户的口令不会被改）：必填，无默认口令——
# 留为 CHANGE_ME 时 go 拒绝启动；改成你自己的口令（如 openssl rand -hex 16）
BRP_AUTH_SEED_USERNAME=admin
BRP_AUTH_SEED_PASSWORD=CHANGE_ME
